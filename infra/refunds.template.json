{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Flashinho demo - private receipts and refund triage queue",
  "Resources": {
    "Receipts": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "flashinho-receipts-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "DeleteDemoReceipts",
              "Status": "Enabled",
              "ExpirationInDays": 7
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "flashinho-demo"
          }
        ]
      }
    },
    "ReceiptsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Receipts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["Receipts", "Arn"]
                },
                {
                  "Fn::Sub": "${Receipts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "DeadLetters": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "flashinho-refunds-dlq",
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "flashinho-demo"
          }
        ]
      }
    },
    "RefundQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "flashinho-refunds",
        "VisibilityTimeout": 60,
        "ReceiveMessageWaitTimeSeconds": 10,
        "MessageRetentionPeriod": 345600,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": ["DeadLetters", "Arn"]
          },
          "maxReceiveCount": 5
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "flashinho-demo"
          }
        ]
      }
    },
    "AppUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": "flashinho-demo-app",
        "Tags": [
          {
            "Key": "Project",
            "Value": "flashinho-demo"
          }
        ],
        "Policies": [
          {
            "PolicyName": "FlashinhoDemoOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
                  "Resource": {
                    "Fn::Sub": "${Receipts.Arn}/refunds/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": ["RefundQueue", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Receipts"
      }
    },
    "QueueUrl": {
      "Value": {
        "Ref": "RefundQueue"
      }
    },
    "DeadLetterQueueUrl": {
      "Value": {
        "Ref": "DeadLetters"
      }
    },
    "User": {
      "Value": {
        "Ref": "AppUser"
      }
    }
  }
}
